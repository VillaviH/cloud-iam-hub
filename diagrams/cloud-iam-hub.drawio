        <mxCell id="e10" value="boto3: user/keys/policies/DenyAll" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=10;strokeColor=#B35A00;" edge="1" parent="1" source="adpAws" target="awsbox">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e11" value="Graph: accountEnabled" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=10;strokeColor=#004578;" edge="1" parent="1" source="adpAzure" target="azEntra">
          <mxGeometry relative="1" as="geometry" />
