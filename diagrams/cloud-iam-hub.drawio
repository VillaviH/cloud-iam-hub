        <mxCell id="e12" value="RBAC: roleAssignment" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=10;strokeColor=#004578;" edge="1" parent="1" source="adpAzure" target="azRbac">
          <mxGeometry relative="1" as="geometry" />
