        <mxCell id="e13" value="6. escribe Audit (before/after)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;dashed=1;fontSize=10;strokeColor=#B06000;exitX=0.5;exitY=1;entryX=0.9;entryY=0;" edge="1" parent="1" source="workers" target="fs">
