# Copiar a .env (gitignored) y completar con tus propios valores.
# NUNCA commitear el archivo .env real.

# --- Modo ---
# sandbox: no hace ninguna llamada real, usa MockAdapter + memoria (por defecto).
# live:    llamadas reales a AWS / GCP / Azure con las credenciales de abajo.
CLOUD_IAM_MODE=sandbox

# --- GCP (Firestore + recurso gobernado) ---
GCP_PROJECT_ID=tu-proyecto-gcp
GOOGLE_APPLICATION_CREDENTIALS=./gcp-sa.json
GCP_DEMO_TARGET_RESOURCE_MEMBER=cloud-iam-hub-demo-target@tu-proyecto-gcp.iam.gserviceaccount.com

# --- AWS ---
# Usar un perfil/rol dedicado (nunca credenciales de administrador personal).
# boto3 toma las credenciales del entorno estándar de AWS
# (AWS_PROFILE, variables AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY, o el
# usuario dedicado creado por infra/aws -> backend_operator).
AWS_REGION=us-east-1
AWS_DEMO_IAM_PATH=/cloud-iam-hub-demo/
AWS_DEMO_TARGET_POLICY_ARN=arn:aws:iam::<account-id>:policy/cloud-iam-hub-demo-viewer

# --- Azure ---
# IMPORTANTE: usar SIEMPRE un tenant propio/personal, nunca uno corporativo.
# El backend valida en runtime que AZURE_TENANT_ID coincida con el tenant
# real usado por el service principal (ver app/config.py).
AZURE_TENANT_ID=tu-tenant-id
AZURE_SUBSCRIPTION_ID=tu-subscription-id
AZURE_CLIENT_ID=tu-app-client-id
AZURE_CLIENT_SECRET=tu-client-secret
AZURE_RESOURCE_GROUP=rg-cloud-iam-hub-demo
AZURE_UPN_DOMAIN=tu-tenant.onmicrosoft.com

# --- API ---
API_CORS_ORIGINS=*
# Si se define, POST /onboard, POST /offboard y GET /audit exigen el
# header X-Api-Key con este valor. Dejar vacío solo para desarrollo local.
# Generar uno con: openssl rand -hex 24
API_SHARED_SECRET=
